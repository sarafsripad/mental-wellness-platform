      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/clinic/"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "wellness-api-audience",
        "consent:read",
        "consent:write",
        "careteam:read",
        "encounters:read",
        "encounters:write",
        "identity:lookup"
      ],
      "optionalClientScopes": []
    }
  ],

      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "wellness-api-audience",
        "consent:read",
        "consent:write",
        "voice:read",
        "voice:write",
        "processing:read",
        "processing:write"
      ],
      "optionalClientScopes": []

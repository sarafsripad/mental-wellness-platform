{
  "realm": "wellness-local",
  "displayName": "Wellness (local development, synthetic users only)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "ASHA_WORKER",
        "description": "Community health worker; assigned participants only"
      },
      {
        "name": "CLINICIAN",
        "description": "Doctor or clinician; reviews flagged cases and, at a facility, sees its care-team participants"
      },
      {
        "name": "ADMIN",
        "description": "Programme administration; access is reason-coded and audited"
      },
      {
        "name": "PROCESSING_WORKER",
        "description": "Service role for the audio-processing worker"
      },
      {
        "name": "PARTNER_SYSTEM",
        "description": "Service role for partner programme systems (SIMULATED partners only in this environment)"
      },
      {
        "name": "COUNSELLOR",
        "description": "Trained counsellor; reaches participants only through a facility on their care team"
      },
      {
        "name": "HEALTH_STAFF",
        "description": "ANM, nurse or other health staff; no access to notes, diagnoses or scores"
      }
    ]
  },
  "defaultRoles": [],
  "clientScopes": [
    {
      "name": "basic",
      "description": "Subject claim only (no profile data in tokens)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "Realm roles in realm_access.roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "wellness-api-audience",
      "description": "Adds aud=wellness-api",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "wellness-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "wellness-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "consent:read",
      "description": "Read consent events and status",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "consent:write",
      "description": "Record consent events and withdrawals",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "voice:read",
      "description": "Read voice sessions",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "voice:write",
      "description": "Create voice sessions and upload recordings",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "processing:read",
      "description": "Read processing job status",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "processing:write",
      "description": "Submit processing jobs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "cases:read",
      "description": "Read ASHA assessment cases",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "cases:write",
      "description": "Open and update ASHA assessment cases; store identity (write-only)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "review:read",
      "description": "Read the clinician review queue (pseudonymous)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "review:write",
      "description": "Record clinician review decisions",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "careteam:read",
      "description": "Read care teams and own facility memberships",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "careteam:write",
      "description": "Refer an assigned participant to a facility",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "careteam:admin",
      "description": "Administer facilities, staff memberships and care teams (reason-coded)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "encounters:read",
      "description": "Read clinic encounters, timelines (role-filtered)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "encounters:write",
      "description": "Record clinic encounters, assessments, diagnoses, care plans",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "identity:lookup",
      "description": "Audited, reason-coded patient identity lookup and search (care-team staff)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "processing:worker",
      "description": "Processing worker: claim jobs, fetch leased audio, submit results",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "partner:events",
      "description": "Post referral status events (partner systems)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    }
  ],
  "defaultDefaultClientScopes": [
    "basic",
    "roles",
    "wellness-api-audience"
  ],
  "defaultOptionalClientScopes": [],
  "clients": [
    {
      "clientId": "wellness-mobile",
      "name": "Mobile app (authorization code + PKCE)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "org.mentalwellness.app:/oauth2redirect"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "org.mentalwellness.app:/logout"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "wellness-api-audience",
        "consent:read",
        "consent:write",
        "voice:read",
        "voice:write",
        "processing:read",
        "processing:write",
        "cases:read",
        "cases:write",
        "careteam:read",
        "careteam:write"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "processing-worker",
      "name": "Audio-processing worker (client credentials)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${PROCESSING_WORKER_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "wellness-api-audience",
        "processing:worker"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "partner-simulator",
      "name": "LOCAL ONLY: SIMULATED partner programmes (client credentials)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${PARTNER_SIMULATOR_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "wellness-api-audience",
        "partner:events"
      ],
      "optionalClientScopes": [],
      "description": "deploy/local/partner-simulator. Stands in for partner systems in tests; not a real partner. Never create elsewhere."
    },
    {
      "clientId": "wellness-e2e",
      "name": "LOCAL ONLY: automated end-to-end tests (password grant)",
      "description": "Exists only in the local realm so tests can log in as synthetic users. Never create this client in any other environment.",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${E2E_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "wellness-api-audience",
        "consent:read",
        "consent:write",
        "voice:read",
        "voice:write",
        "processing:read",
        "processing:write",
        "cases:read",
        "cases:write",
        "review:read",
        "review:write",
        "careteam:read",
        "careteam:write",
        "careteam:admin",
        "encounters:read",
        "encounters:write",
        "identity:lookup"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "wellness-dev-console",

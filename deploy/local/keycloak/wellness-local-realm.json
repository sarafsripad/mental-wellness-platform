{
  "realm": "wellness-local",
  "displayName": "Wellness (local development, synthetic users only)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "ASHA_WORKER",
        "description": "Community health worker; assigned participants only"
      },
      {
        "name": "CLINICIAN",
        "description": "Reviews cases in an assigned catchment"
      },
      {
        "name": "ADMIN",
        "description": "Programme administration; access is reason-coded and audited"
      },
      {
        "name": "PROCESSING_WORKER",
        "description": "Service role for the audio-processing worker"
      }
    ]
  },
  "defaultRoles": [],
  "clientScopes": [
    {
      "name": "basic",
      "description": "Subject claim only (no profile data in tokens)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "Realm roles in realm_access.roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "wellness-api-audience",
      "description": "Adds aud=wellness-api",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "wellness-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "wellness-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "consent:read",
      "description": "Read consent events and status",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "consent:write",
      "description": "Record consent events and withdrawals",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "voice:read",
      "description": "Read voice sessions",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "voice:write",
      "description": "Create voice sessions and upload recordings",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "processing:read",
      "description": "Read processing job status",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "processing:write",
      "description": "Submit processing jobs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "processing:worker",
      "description": "Processing worker: claim jobs, fetch leased audio, submit results",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    }
  ],
  "defaultDefaultClientScopes": [
    "basic",
    "roles",
    "wellness-api-audience"
  ],
  "defaultOptionalClientScopes": [],
  "clients": [
    {
      "clientId": "wellness-mobile",
      "name": "Mobile app (authorization code + PKCE)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "org.mentalwellness.app:/oauth2redirect"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "org.mentalwellness.app:/logout"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "wellness-api-audience",
        "consent:read",
        "consent:write",
        "voice:read",
        "voice:write",
        "processing:read",
        "processing:write"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "processing-worker",
      "name": "Audio-processing worker (client credentials)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${PROCESSING_WORKER_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "wellness-api-audience",
        "processing:worker"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "wellness-e2e",
      "name": "LOCAL ONLY: automated end-to-end tests (password grant)",
      "description": "Exists only in the local realm so tests can log in as synthetic users. Never create this client in any other environment.",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${E2E_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "wellness-api-audience",
        "consent:read",
        "consent:write",
        "voice:read",
        "voice:write",
        "processing:read",
        "processing:write"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "asha.test1",
      "enabled": true,
      "emailVerified": true,
      "email": "asha.test1@example.invalid",
      "firstName": "Synthetic",
      "lastName": "ASHA One",
      "realmRoles": [
        "ASHA_WORKER"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "asha.test2",
      "enabled": true,
      "emailVerified": true,
      "email": "asha.test2@example.invalid",
      "firstName": "Synthetic",
      "lastName": "ASHA Two",
      "realmRoles": [
        "ASHA_WORKER"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "clinician.test1",
      "enabled": true,
      "emailVerified": true,
      "email": "clinician.test1@example.invalid",
      "firstName": "Synthetic",
      "lastName": "Clinician One",
      "realmRoles": [
        "CLINICIAN"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "admin.test1",
      "enabled": true,
      "emailVerified": true,
      "email": "admin.test1@example.invalid",
      "firstName": "Synthetic",
      "lastName": "Admin One",
      "realmRoles": [
        "ADMIN"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-processing-worker",
      "enabled": true,
      "serviceAccountClientId": "processing-worker",
      "realmRoles": [
        "PROCESSING_WORKER"
      ]
    }
  ]
}
